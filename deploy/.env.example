# 服务器 /opt/autonotice/.env（600 权限、LF 换行；§9-坑3）
# 真实密钥只存在于服务器与本地密码管理器，绝不入库

PORT=8080
LOG_LEVEL=info

# LLM（dashscope compatible-mode）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-替换为真实密钥
LLM_MODEL=deepseek-v4.1-flash
LLM_VISION_MODEL=qwen3-vl-plus
LLM_EMBEDDING_MODEL=text-embedding-v4

# OneBot v11 反向 WS（与 NapCat 侧 access_token 一致）
ONEBOT_WS_PATH=/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=替换为随机串

# 认证
JWT_SECRET=替换为随机串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=替换为强密码

# 数据
DATABASE_PATH=/app/data/app.db
