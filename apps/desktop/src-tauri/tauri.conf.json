{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autonotice",
  "version": "2.2.0",
  "identifier": "com.autonotice.app",
  "build": {
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Autonotice",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
